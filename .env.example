NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=

# Search stays off until a real HTTPS domain and production environment are set.
# Vercel provides VERCEL_ENV; other hosts must set SITE_ENV=production.
SITE_ENV=preview
SITE_INDEXING_ENABLED=false

# Import-only write token. Keep it in .env.local; never expose it with NEXT_PUBLIC_.
SANITY_API_TOKEN=
